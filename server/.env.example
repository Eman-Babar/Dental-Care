PORT=5000
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
DATABASE_URL_DIRECT="postgresql://USER:PASSWORD@HOST-without-pooler/neondb?sslmode=require"
JWT_SECRET="your_jwt_secret_key"

# Nodemailer SMTP Configuration
EMAIL_HOST="smtp.mailtrap.io"
EMAIL_PORT=2525
EMAIL_USER="your_smtp_user"
EMAIL_PASS="your_smtp_password"
EMAIL_FROM="Dental Clinic <no-reply@dentalcare.com>"
# Inbox that receives new appointment notifications
CLINIC_EMAIL="clinic@dentalcare.com"
