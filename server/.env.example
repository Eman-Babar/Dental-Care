PORT=5000
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
DATABASE_URL_DIRECT="postgresql://USER:PASSWORD@HOST-without-pooler/neondb?sslmode=require"
JWT_SECRET="your_jwt_secret_key"

# --- Gmail SMTP (recommended for real inbox delivery) ---
# 1) Google Account → Security → turn ON 2-Step Verification
# 2) Security → App passwords → Mail / Other → generate 16-char password
# 3) Paste below (spaces in app password are fine to remove)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER="your_gmail@gmail.com"
EMAIL_PASS="your_16_char_app_password"
EMAIL_FROM="DentalCare Clinic <your_gmail@gmail.com>"
# Clinic inbox that receives new appointment alerts
CLINIC_EMAIL="your_gmail@gmail.com"
