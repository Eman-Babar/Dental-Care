PORT=5000
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
DATABASE_URL_DIRECT="postgresql://USER:PASSWORD@HOST-without-pooler/neondb?sslmode=require"
JWT_SECRET="replace_with_a_long_random_secret"

# Frontend URL(s) for CORS + password-reset email links
CLIENT_URL="http://localhost:5173"
# Comma-separated if you have multiple (local + Vercel)
CLIENT_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# --- Gmail SMTP ---
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER="your_gmail@gmail.com"
EMAIL_PASS="your_16_char_app_password"
EMAIL_FROM="Clinic <your_gmail@gmail.com>"
CLINIC_EMAIL="your_gmail@gmail.com"

# Hourly appointment reminder emails (set false to disable)
REMINDERS_ENABLED=true

# Morning clinic digest to CLINIC_EMAIL (server local time; set TZ=Asia/Karachi on host)
DIGEST_ENABLED=true
# Optional cron override (default 08:05)
# DIGEST_CRON="5 8 * * *"

# Optional Stripe card deposits (leave blank to use JazzCash/bank instructions only)
STRIPE_SECRET_KEY=
# Example: sk_test_...
