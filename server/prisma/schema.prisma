datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_DIRECT")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  DOCTOR
  PATIENT
}

enum AppointmentStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  DEPOSIT_DUE
  DEPOSIT_PAID
  PAID
  WAIVED
}

enum TicketStatus {
  WAITING
  CALLED
  IN_PROGRESS
  DONE
  SKIPPED
  CANCELLED
}

model User {
  id          Int      @id @default(autoincrement())
  name        String
  email       String   @unique
  password    String

  role        Role

  phone       String?
  image       String?

  resetPasswordToken   String?
  resetPasswordExpires DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Doctor Profile (Only for doctors)
  doctorProfile DoctorProfile?

  // Patient Appointments
  patientAppointments Appointment[] @relation("PatientAppointments")

  // Doctor Appointments
  doctorAppointments Appointment[] @relation("DoctorAppointments")

  reviewsWritten   Review[] @relation("PatientReviews")
  reviewsReceived  Review[] @relation("DoctorReviews")

  doctorLeaves     DoctorLeave[] @relation("DoctorLeaves")
  doctorTickets    Ticket[]      @relation("DoctorTickets")

  @@map("users")
}

model DoctorProfile {
  id               Int    @id @default(autoincrement())

  userId           Int    @unique
  user             User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  specialization   String
  qualification    String?
  experience       Int?
  bio              String?

  workingDays      String?
  workingHours     String?
  availability     Json?

  services         Service[] @relation("DoctorServices")
  ownedServices    Service[] @relation("DoctorOwnedServices")

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("doctor_profiles")
}

model Service {
  id              Int      @id @default(autoincrement())

  title           String
  description     String

  image           String?

  duration        Int?      // minutes

  price           Float?

  isGlobal        Boolean  @default(true)

  ownerDoctorProfileId Int?
  ownerDoctorProfile   DoctorProfile? @relation("DoctorOwnedServices", fields: [ownerDoctorProfileId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  appointments    Appointment[]
  doctorProfiles  DoctorProfile[] @relation("DoctorServices")
  tickets         Ticket[]

  @@map("services")
}

model Appointment {
  id                Int      @id @default(autoincrement())

  patientId         Int
  patient           User     @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Cascade)

  doctorId          Int?
  doctor            User?    @relation("DoctorAppointments", fields: [doctorId], references: [id])

  serviceId         Int
  service           Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  appointmentDate   DateTime

  appointmentTime   String

  medicalHistory    String?

  currentProblem    String

  notes             String?

  rejectionReason   String?

  cancellationReason String?

  status            AppointmentStatus @default(PENDING)

  paymentStatus     PaymentStatus @default(UNPAID)
  depositAmount     Float?
  amountPaid        Float?    @default(0)

  paymentNote       String?
  paymentClaimedAt  DateTime?
  stripeSessionId   String?

  reminderSentAt    DateTime?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  review            Review?

  @@map("appointments")
}

model Review {
  id             Int      @id @default(autoincrement())

  patientId      Int
  patient        User     @relation("PatientReviews", fields: [patientId], references: [id], onDelete: Cascade)

  doctorId       Int
  doctor         User     @relation("DoctorReviews", fields: [doctorId], references: [id], onDelete: Cascade)

  appointmentId  Int      @unique
  appointment    Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  rating         Int
  comment        String

  /// Admin moderation — only published reviews appear on the public site
  isPublished    Boolean  @default(true)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("reviews")
}

model AuditLog {
  id          Int      @id @default(autoincrement())

  actorId     Int?
  actorRole   String?
  actorEmail  String?

  action      String
  entity      String?
  entityId    String?
  details     String?

  createdAt   DateTime @default(now())

  @@map("audit_logs")
}

/// Editable site copy / images for staff (basic CMS)
model SiteContent {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  label     String
  value     String
  group     String   @default("general")
  updatedAt DateTime @updatedAt

  @@map("site_content")
}

/// Doctor day off / leave (blocks booking slots)
model DoctorLeave {
  id        Int      @id @default(autoincrement())
  doctorId  Int
  doctor    User     @relation("DoctorLeaves", fields: [doctorId], references: [id], onDelete: Cascade)
  date      DateTime
  reason    String?
  createdAt DateTime @default(now())

  @@unique([doctorId, date])
  @@map("doctor_leaves")
}

/// Walk-in / same-day patient queue tickets
model Ticket {
  id           Int          @id @default(autoincrement())
  tokenNo      Int
  date         DateTime
  patientName  String
  phone        String?
  notes        String?
  status       TicketStatus @default(WAITING)

  serviceId    Int?
  service      Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  doctorId     Int?
  doctor       User?        @relation("DoctorTickets", fields: [doctorId], references: [id], onDelete: SetNull)

  calledAt     DateTime?
  startedAt    DateTime?
  completedAt  DateTime?

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([date, tokenNo])
  @@index([date, doctorId, status])
  @@map("tickets")
}